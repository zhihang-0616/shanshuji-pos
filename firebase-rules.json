{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$id": {
        ".read": true,
        ".write": "(auth != null && newData.exists()) || (auth != null && !newData.exists() && root.child('roles').child(auth.uid).val() == 'manager') || (!data.exists() && newData.exists() && root.child('shop/status').val() != '休息中')",
        ".validate": "newData.hasChildren(['no','name','phone','time','items','total','pay','status','createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "phone": {
          ".validate": "newData.isString() && (newData.val().matches(/^09[0-9]{2}-[0-9]{3}-[0-9]{3}$/) || (auth != null && newData.val() == ''))"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'new' || auth != null)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "logs": {
      ".read": "auth != null && root.child('roles').child(auth.uid).val() == 'manager'",
      ".indexOn": [
        "at"
      ],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    },
    "counters": {
      "$d": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() < 10000"
      }
    },
    "soldOut": {
      ".read": true,
      ".write": "auth != null"
    },
    "shop": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}